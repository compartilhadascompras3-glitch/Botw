DATABASE_URL=postgres://postgres:postgres@localhost:5432/vibe_next_template
LOG_DIR=./logs

# ─────────────────────────────────────────────────────────────
# Evolution API (WhatsApp)
# Deploy gratuito: https://railway.app/template/evolution-api
# ─────────────────────────────────────────────────────────────
# URL pública do seu servidor Evolution API
EVOLUTION_API_URL=https://evolution.seudominio.com
# Global API Key (visível no painel do Railway em Variables > AUTHENTICATION_API_KEY)
EVOLUTION_API_KEY=
# Nome da instância WhatsApp (pode deixar como está)
EVOLUTION_INSTANCE=whatsapp-bot

# URL pública do dashboard
NEXT_API_URL=https://seu-app.happyseeds.ai

# ─────────────────────────────────────────────────────────────
# IA do Gerador de Promoções
# ─────────────────────────────────────────────────────────────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free

# Reactus / HappySeeds
REACTUS_BASE_URL=https://reactus-api.happyseeds.ai
HAPPYSEEDS_PROJECT_ID=

# Mercado Livre OAuth (opcional)
